<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Mostrar Responsable de venta en el formulario y lista de facturas -->
  <record id="view_move_form_inherit_enteza_sales" model="ir.ui.view">
    <field name="name">account.move.form.enteza.sales</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='partner_id']" position="after">
        <field name="sale_responsible_id"/>
      </xpath>
    </field>
  </record>

  <record id="view_move_tree_inherit_enteza_sales" model="ir.ui.view">
    <field name="name">account.move.tree.enteza.sales</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_tree"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='partner_id']" position="after">
        <field name="sale_responsible_id"/>
      </xpath>
    </field>
  </record>
</odoo>

