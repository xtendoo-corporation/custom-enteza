<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Añadir Responsable de venta en el formulario y lista de pedidos (incluye alquileres) -->
  <record id="view_sale_order_form_inherit_enteza_sales" model="ir.ui.view">
    <field name="name">sale.order.form.enteza.sales</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='user_id']" position="after">
        <field name="sale_responsible_id"/>
      </xpath>
    </field>
  </record>

  <record id="view_sale_order_tree_inherit_enteza_sales" model="ir.ui.view">
    <field name="name">sale.order.tree.enteza.sales</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_tree"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='partner_id']" position="after">
        <field name="sale_responsible_id"/>
      </xpath>
    </field>
  </record>
</odoo>

