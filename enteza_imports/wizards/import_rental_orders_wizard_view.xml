<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_import_rental_orders_wizard_form" model="ir.ui.view">
        <field name="name">import.rental.orders.wizard.form</field>
        <field name="model">import.rental.orders.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar futuros alquileres desde Excel" enctype="multipart/form-data">
                <group>
                    <field name="file" filename="filename"/>
                    <field name="filename" readonly="1"/>
                </group>
                <footer>
                    <button name="action_import_rental_orders" type="object" string="Importar" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
                <group>
                    <field name="import_log" nolabel="1" readonly="1" widget="text" invisible="context.get('show_log') != True"/>
                </group>
            </form>
        </field>
    </record>

    <record id="action_import_rental_orders_wizard" model="ir.actions.act_window">
        <field name="name">Importar futuros alquileres</field>
        <field name="res_model">import.rental.orders.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_import_rental_orders_wizard_form"/>
    </record>

    <menuitem id="menu_import_rental_orders_wizard" name="Importar futuros alquileres" parent="sale_renting.menu_rental_config" action="action_import_rental_orders_wizard" sequence="30"/>
</odoo>
