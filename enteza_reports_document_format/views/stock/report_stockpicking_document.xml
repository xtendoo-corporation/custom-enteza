<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="report_stock_picking_grouped_for_categories" model="ir.actions.report">
        <field name="name">Albarán Agrupado</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">enteza_reports_document_format.format_report_stock_picking_grouped_for_categories</field>
        <field name="report_file">enteza_reports_document_format.format_report_stock_picking_grouped_for_categories
        </field>
        <field name="print_report_name">'Albarán Agrupado - %s - %s' % (object.partner_id.name or '', object.name)
        </field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
    </record>

    <template id="format_report_stock_picking_grouped_for_categories">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="enteza_reports_document_format.template_document_stock_picking_grouped_for_categories"/>
            </t>
        </t>
    </template>

    <template id="template_document_stock_picking_grouped_for_categories">
        <t t-call="web.external_layout">
            <t t-set="doc" t-value="doc.with_context(lang=doc._get_report_lang())"/>
            <t t-set="partner" t-value="doc.partner_id or (doc.move_ids and doc.move_ids[0].partner_id) or False"/>

            <t t-set="address">
                <div name="div_outgoing_address">
                    <div t-if="doc.picking_type_id.code == 'outgoing' and doc.move_ids and doc.move_ids[0].partner_id">
                        <span>
                            <strong>Dirección de entrega:</strong>
                        </span>
                        <div t-field="doc.move_ids[0].partner_id"
                             t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'/>
                    </div>
                    <div
                        t-elif="doc.picking_type_id.code != 'internal' and doc.picking_type_id.warehouse_id.partner_id">
                        <span>
                            <strong>Dirección de facturación:</strong>
                        </span>
                        <div t-field="doc.picking_type_id.warehouse_id.partner_id"
                             t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'/>
                    </div>
                </div>
            </t>

            <t t-set="information_block">
                <div class="row">
                    <div class="col-7" name="div_incoming_address">
                        <t t-set="show_partner" t-value="False"/>
                        <div t-if="doc.picking_type_id.code=='incoming' and partner">
                            <span>
                                <strong>Dirección del vendedor:</strong>
                            </span>
                            <t t-set="show_partner" t-value="True"/>
                        </div>
                        <div
                            t-if="doc.picking_type_id.code=='outgoing' and partner and partner != partner.commercial_partner_id">
                            <span>
                                <strong>Dirección del cliente:</strong>
                            </span>
                            <t t-set="show_partner" t-value="True"/>
                        </div>
                        <div t-if="show_partner" name="partner_header">
                            <div t-field="partner.commercial_partner_id"
                                 t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'/>
                            <p t-if="partner.sudo().commercial_partner_id.vat">
                                <t t-out="doc.company_id.country_id.vat_label or 'Tax ID'"/>:
                                <span t-field="partner.sudo().commercial_partner_id.vat"/>
                            </p>
                        </div>
                    </div>
                </div>
            </t>

            <div class="page">
                <h2>
                    <span t-field="doc.name"/>
                </h2>
                <div id="informations" class="row mt-4 mb-4">
                    <div t-if="doc.sale_id.partner_id" class="col-auto col-3 mw-100 mb-2" name="div_client">
                        <strong>Cliente:</strong>
                        <p t-field="doc.sale_id.partner_id.name"/>
                    </div>
                    <div t-if="doc.sale_id.event_date" class="col-auto col-3 mw-100 mb-2" name="div_event_date">
                        <strong>Fecha del Evento:</strong>
                        <p t-field="doc.sale_id.event_date"/>
                    </div>
                    <div t-if="doc.origin" class="col-auto col-3 mw-100 mb-2" name="div_origin">
                        <strong>Pedido:</strong>
                        <p t-field="doc.origin"/>
                    </div>
                    <div t-if="doc.state" class="col-auto col-3 mw-100 mb-2" name="div_sched_date">
                        <strong>Fecha de envío:</strong>
                        <t t-if="doc.state == 'done'">
                            <p t-field="doc.date_done"/>
                        </t>
                        <t t-else="">
                            <p t-field="doc.scheduled_date"/>
                        </t>
                    </div>
                </div>

                <table class="table table-sm table-borderless" t-if="doc.state != 'done'" name="stock_move_table">
                    <thead>
                        <tr>
                            <th name="th_sm_product">
                                <strong>Producto</strong>
                            </th>
                            <th name="th_sm_ordered" class="text-right">
                                <strong>Pedidos</strong>
                            </th>
                            <th name="th_sm_quantity" class="text-right">
                                <strong>Reservados</strong>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Agrupar por ubicación (location_id) y luego por categoría -->
                        <t t-foreach="doc.stock_used_locations" t-as="location">
                            <t t-set="location_move_lines"
                               t-value="doc.move_line_ids.filtered(lambda l: l.location_id == location)"/>
                            <t t-if="location_move_lines">
                                <!-- Mostrar cabecera de ubicación -->
                                <tr>
                                    <td colspan="3"
                                        style="text-align:left;border-bottom:3px solid #000;border-top:3px solid #000;background:#c5cad1;font-size:1.1em;">
                                        <strong><span t-field="location.complete_name"/></strong>
                                    </td>
                                </tr>

                                <!-- Iterar por categorías dentro de esta ubicación -->
                                <t t-foreach="doc.stock_used_categories" t-as="category">
                                    <t t-set="category_move_lines"
                                       t-value="location_move_lines.filtered(lambda l: l.product_id and l.product_id.categ_id and l.product_id.categ_id.id == category.id)"/>
                                    <t t-if="category_move_lines">
                                        <!-- Mostrar cabecera de categoría -->
                                        <tr>
                                            <td colspan="3"
                                                style="text-align:left;border-bottom:2px solid black;border-top:2px solid black;background:#e1e5eb;padding-left:20px;">
                                                <strong>
                                                    <span t-field="category.name"/>
                                                </strong>
                                            </td>
                                        </tr>

                                        <!-- Mostrar productos (agrupados por producto) -->
                                        <t t-set="shown_products" t-value="set()"/>
                                        <t t-foreach="category_move_lines" t-as="move_line">
                                            <t t-set="product_key" t-value="str(move_line.product_id.id)"/>
                                            <t t-if="product_key not in shown_products">
                                                <t t-set="dummy" t-value="shown_products.add(product_key)"/>
                                                <!-- Calcular totales para este producto -->
                                                <t t-set="same_product_lines" t-value="category_move_lines.filtered(lambda l: l.product_id == move_line.product_id)"/>
                                                <t t-set="total_qty" t-value="sum(same_product_lines.mapped('quantity'))"/>
                                                <t t-set="total_ordered" t-value="sum(same_product_lines.mapped('move_id.product_uom_qty'))"/>

                                                <tr>
                                                    <td style="padding-left:30px;">
                                                        <span t-field="move_line.product_id.display_name"/>
                                                        <p t-if="move_line.description_picking and move_line.description_picking != move_line.product_id.name and move_line.description_picking != move_line.product_id.display_name">
                                                            <span t-field="move_line.description_picking"/>
                                                        </p>
                                                    </td>
                                                    <td class="text-right">
                                                        <span t-esc="'{0:.2f}'.format(total_ordered)"/>
                                                    </td>
                                                    <td class="text-right">
                                                        <span t-esc="'{0:.2f}'.format(total_qty)"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </t>
                                    </t>
                                </t>
                            </t>
                        </t>
                    </tbody>
                </table>

                <table class="table table-sm mt48 table-borderless" t-if="doc.move_line_ids and doc.state == 'done'"
                       name="stock_move_line_table">
                    <t t-set="has_serial_number" t-value="doc.move_line_ids.lot_id"
                       groups="stock.group_lot_on_delivery_slip"/>
                    <thead>
                        <tr>
                            <th name="th_sml_product">
                                <strong>Producto</strong>
                            </th>
                            <t name="lot_serial" t-if="has_serial_number">
                                <th>Lote/Número de serie</th>
                            </t>
                            <th name="th_sml_qty_ordered" class="text-center" t-if="not has_serial_number">
                                <strong>Pedido</strong>
                            </th>
                            <th name="th_sml_quantity" class="text-center">
                                <strong>Entregados</strong>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Agrupar por ubicación y luego por categorías -->
                        <t t-foreach="doc.stock_used_locations" t-as="location">
                            <t t-set="location_move_lines"
                               t-value="doc.move_line_ids.filtered(lambda l: l.location_id == location)"/>
                            <t t-if="location_move_lines">
                                <!-- Mostrar cabecera de ubicación -->
                                <tr>
                                    <td t-attf-colspan="#{4 if has_serial_number else 3}"
                                        style="text-align:left;border-bottom:3px solid #000;border-top:3px solid #000;background:#c5cad1;font-size:1.1em;">
                                        <strong><span t-field="location.complete_name"/></strong>
                                    </td>
                                </tr>

                                <!-- Iterar por categorías dentro de esta ubicación -->
                                <t t-foreach="doc.stock_used_categories" t-as="category">
                                    <t t-set="category_move_lines"
                                       t-value="location_move_lines.filtered(lambda l: l.product_id and l.product_id.categ_id and l.product_id.categ_id.id == category.id)"/>
                                    <t t-if="category_move_lines">
                                        <!-- Mostrar cabecera de categoría -->
                                        <tr>
                                            <td t-attf-colspan="#{4 if has_serial_number else 3}"
                                                style="text-align:left;border-bottom:2px solid black;border-top:2px solid black;background:#e1e5eb;padding-left:20px;">
                                                <strong>
                                                    <span t-field="category.name"/>
                                                </strong>
                                            </td>
                                        </tr>

                                        <!-- Procesar líneas de esta categoría -->
                                        <t t-if="doc.packages_count" name="has_packages">
                                            <t t-set="packages" t-value="category_move_lines.mapped('result_package_id')"/>
                                            <t t-foreach="packages" t-as="package">
                                                <t t-call="stock.stock_report_delivery_package_section_line"/>
                                                <t t-set="package_move_lines"
                                                   t-value="category_move_lines.filtered(lambda l: l.result_package_id == package)"/>
                                                <!-- If printing lots/serial numbers => keep products in original lines -->
                                                <t t-if="has_serial_number">
                                                    <tr t-foreach="package_move_lines" t-as="move_line">
                                                        <t t-call="stock.stock_report_delivery_has_serial_move_line"/>
                                                    </tr>
                                                </t>
                                                <!-- If not printing lots/serial numbers => merge lines with same product+description+uom -->
                                                <t t-else="">
                                                    <t t-set="aggregated_lines"
                                                       t-value="package_move_lines._get_aggregated_product_quantities(strict=True)"/>
                                                    <t t-call="enteza_reports_document_format.stock_report_delivery_aggregated_move_lines_inherit"/>
                                                </t>
                                            </t>
                                            <!-- Make sure we do another section for package-less products if they exist -->
                                            <t t-set="move_lines"
                                               t-value="category_move_lines.filtered(lambda l: not l.result_package_id)"/>
                                            <t t-set="aggregated_lines"
                                               t-value="category_move_lines._get_aggregated_product_quantities(except_package=True)"/>
                                            <t t-if="move_lines or aggregated_lines" name="no_package_move_lines">
                                                <t t-call="stock.stock_report_delivery_no_package_section_line"
                                                   name="no_package_section"/>
                                                <t t-if="has_serial_number">
                                                    <tr t-foreach="move_lines" t-as="move_line">
                                                        <t t-call="stock.stock_report_delivery_has_serial_move_line"/>
                                                    </tr>
                                                </t>
                                                <t t-elif="aggregated_lines">
                                                    <t t-call="enteza_reports_document_format.stock_report_delivery_aggregated_move_lines_inherit"/>
                                                </t>
                                            </t>
                                        </t>
                                        <!-- No destination packages -->
                                        <t t-else="">
                                            <!-- If printing lots/serial numbers => keep products in original lines -->
                                            <t t-if="has_serial_number">
                                                <tr t-foreach="category_move_lines" t-as="move_line">
                                                    <t t-call="stock.stock_report_delivery_has_serial_move_line"/>
                                                </tr>
                                            </t>
                                            <!-- If not printing lots/serial numbers => merge lines with same product -->
                                            <t t-else="" name="aggregated_move_lines">
                                                <t t-set="aggregated_lines"
                                                   t-value="category_move_lines._get_aggregated_product_quantities()"/>
                                                <t t-call="enteza_reports_document_format.stock_report_delivery_aggregated_move_lines_inherit"/>
                                            </t>
                                        </t>
                                    </t>
                                </t>
                            </t>
                        </t>
                    </tbody>
                </table>

                <t t-set="backorders"
                   t-value="doc.backorder_ids.filtered(lambda x: x.state not in ('done', 'cancel'))"/>
                <t t-if="backorders">
                    <p class="mt-5">
                        <span>Cantidad restante que no ha sido entregada:</span>
                    </p>
                    <table class="table table-sm table-borderless" name="stock_backorder_table"
                           style="table-layout: fixed;">
                        <thead>
                            <tr>
                                <th name="th_sb_product">
                                    <strong>Producto</strong>
                                </th>
                                <th/>
                                <th name="th_sb_quantity" class="text-center">
                                    <strong>Cantidad</strong>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="backorders" t-as="backorder">
                                <t t-set="bo_lines" t-value="backorder.move_ids.filtered(lambda x: x.product_uom_qty)"/>
                                <tr t-foreach="bo_lines" t-as="bo_line">
                                    <td class="w-auto">
                                        <span t-field="bo_line.product_id"/>
                                        <p t-if="bo_line.description_picking != bo_line.product_id.name and bo_line.description_picking != bo_line.product_id.display_name">
                                            <span t-field="bo_line.description_picking"/>
                                        </p>
                                    </td>
                                    <td/>
                                    <td class="text-right text-end">
                                        <span t-field="bo_line.product_uom_qty"/>
                                        <span t-field="bo_line.product_uom"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </t>

                <div t-if="doc.signature" class="mt32 ms-64 me-4" name="signature">
                    <div class="offset-8">
                        <strong>Firma</strong>
                    </div>
                    <div class="offset-8">
                        <img t-att-src="image_data_uri(doc.signature)" style="max-height: 4cm; max-width: 8cm;"/>
                    </div>
                    <div class="offset-8 text-center">
                        <p t-field="doc.partner_id.name"/>
                    </div>
                </div>
            </div>
        </t>
    </template>

<template id="stock_report_delivery_aggregated_move_lines_inherit" inherit_id="stock.stock_report_delivery_aggregated_move_lines">
    <!-- Reemplazar cantidad pedida -->
    <xpath expr="//td[@name='move_line_aggregated_qty_ordered']/span[1]" position="replace">
        <span t-esc="'{0:.2f}'.format(aggregated_lines[line]['qty_ordered'])"/>
    </xpath>

    <!-- Reemplazar cantidad entregada -->
    <xpath expr="//td[@name='move_line_aggregated_quantity']/t/span[1]" position="replace">
        <span t-esc="'{0:.2f}'.format(aggregated_lines[line]['quantity'])"/>
    </xpath>

    <!-- Reemplazar cantidades de packaging si existen -->
    <xpath expr="//td[@name='move_line_aggregated_qty_ordered']//span[@class='text-muted'][1]" position="replace">
        <span class="text-muted" t-esc="'{0:.2f}'.format(aggregated_lines[line]['packaging_qty_ordered'])"/>
    </xpath>

    <xpath expr="//td[@name='move_line_aggregated_quantity']//span[@class='text-muted'][1]" position="replace">
        <span class="text-muted" t-esc="'{0:.2f}'.format(aggregated_lines[line]['packaging_quantity'])"/>
    </xpath>
</template>

</odoo>

